# --- ElevenLabs ---
# Domyślny klucz API. Trzymany WYŁĄCZNIE po stronie serwera — nigdy nie trafia do przeglądarki.
ELEVENLABS_API_KEY=your_api_key_here

# Agenci do wyboru w aplikacji: AGENT_<NAZWA>_ID (ID zaczyna się od "agent_").
AGENT_LEXAI_ID=agent_...
AGENT_BENIO_ID=agent_...
AGENT_JERZY_ID=agent_...
# Opcjonalnie osobny klucz API dla agenta z innego konta ElevenLabs:
# AGENT_JERZY_API_KEY=...
# Opcjonalnie własna nazwa przycisku:
# AGENT_BENIO_NAME=Benio

# Stara konfiguracja: bez AGENT_<NAZWA>_ID — jedyny agent; z nimi — agent domyślny na nowych telefonach.
# ELEVENLABS_AGENT_ID=agent_...

# --- Opcjonalne ---
# Port. Na Railway ustawiany automatycznie (process.env.PORT). Lokalnie domyślnie 3000.
# PORT=3000
# Ogranicz CORS do konkretnego origin (domyślnie odbija origin żądania).
# ALLOWED_ORIGIN=https://twoja-domena.up.railway.app
